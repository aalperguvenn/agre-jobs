# Postgres (Supabase). Migrations: npm run db:migrate
DATABASE_URL=postgres://postgres:password@localhost:5432/agre

# Meilisearch (search index for the Jobs board)
MEILI_HOST=http://localhost:7700
MEILI_ADMIN_KEY=          # worker only
MEILI_SEARCH_KEY=         # web only (search-only key)
MEILI_JOBS_INDEX=jobs

# Careerjet partner API — source starts DISABLED; see apps/worker/src/sources/careerjet.ts before enabling
CAREERJET_API_KEY=
CAREERJET_USER_IP=        # public IP of the worker server (the API requires user_ip)
CAREERJET_LOCALE=tr_TR    # confirm with Careerjet
CAREERJET_MAX_PAGES=2

# Polite crawler identity for ATS and employer-feed requests: put your public bot-info URL and a contact address here
AGRE_USER_AGENT=AgreJobsBot/1.0 (+https://YOUR-DOMAIN/bot; YOUR-CONTACT-ADDRESS)

# Monday curator digest (Resend)
RESEND_API_KEY=
CURATOR_EMAILS=           # comma-separated curator addresses
DIGEST_FROM=              # e.g. Agre Jobs <sender on your verified Resend domain>
APP_URL=https://YOUR-DOMAIN

# Web
SESSION_HASH_SECRET=change-me   # salts the daily click-session hash
CURATOR_DEV_BYPASS=0            # 1 = open /curate locally without auth (never in production)
